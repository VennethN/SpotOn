# Salin ke .env lalu isi. Berkas .env tidak ikut ter-commit.

# Lapisan pemahaman bahasa (OpenRouter). Tanpa kunci ini aplikasi tetap jalan —
# pertanyaan diurai pengurai aturan cadangan, dan seluruh angka tetap dihitung
# mesin skor dari data. Yang hilang cuma kepandaian memahami kalimat bebas.
OPENROUTER_API_KEY=

# Opsional. Default: anthropic/claude-sonnet-5
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# URL gaya MAPID MAPS. Wajib diisi untuk produk final; bila kosong dipakai
# basemap raster terbuka (OpenStreetMap/CARTO) sebagai gantinya.
PUBLIC_MAPID_STYLE_URL=
